# Optional: Claude reads each low-star review and writes a news-style headline (about $1-3/month).
# Leave empty for free mode: only 1-2 star reviews, headline = the review's opening words.
ANTHROPIC_API_KEY=

# Outscraper (outscraper.com) - fetches the newest Google reviews
OUTSCRAPER_API_KEY=

# Telegram - the bot that posts new bad reviews to your channel (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: max Google reviews Outscraper may return per month (default 3800, about $10)
MONTHLY_REVIEW_BUDGET=
